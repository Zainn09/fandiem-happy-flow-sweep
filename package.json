{
  "name": "fandiem-existing-chrome-automation",
  "version": "3.0.0",
  "private": true,
  "description": "Browser-only Fandiem sweep happy-flow automation against the user's existing Chrome profile via Playwright Extension.",
  "scripts": {
    "profile": "node scripts/profile.js",
    "attach": "node scripts/attach.js",
    "test": "node scripts/run.js",
    "dry": "node scripts/run.js --dry-run",
    "report": "node scripts/report.js",
    "detach": "node scripts/detach.js",
    "report:py": "python scripts/report.py",
    "test:py": "python scripts/run.py",
    "dry:py": "python scripts/run.py --dry-run"
  },
  "devDependencies": {
    "@playwright/cli": "latest",
    "playwright": "^1.64.0-alpha-2026-09-14"
  }
}